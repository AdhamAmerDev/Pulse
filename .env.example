DATABASE_URL=postgresql://user:password@localhost:5432/pulse
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
SETUP_EMAIL=admin@example.com
SETUP_PASSWORD=replace-with-a-strong-password
# Optional key for the built-in test page. Dashboard sites get keys automatically.
NEXT_PUBLIC_TEST_SITE_INGEST_KEY=replace-with-the-demo-site-ingest-key
# Generate one per deployment: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-cron-secret
